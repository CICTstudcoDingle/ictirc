{
  "extends": "@ictirc/config/typescript.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "declarationMap": true,
    "lib": ["esnext", "dom"],
    "declaration": true,
    "outDir": "./dist",
    "sourceMap": true,
    "noUnusedLocals": false,
    "rootDir": "./src",
    "strict": false,
    "noEmit": false
  },
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.test.tsx"],
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*"]
}
