{
  "extends": "@ictirc/config/typescript.json",
  "compilerOptions": {
    "rootDir": "./src",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declarationMap": true,
    "declaration": true,
    "outDir": "./dist",
    "jsx": "react-jsx",
    "noEmit": false
  },
  "exclude": ["node_modules", "dist"],
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*"]
}
