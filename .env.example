# Copy this file to .env.local and fill in the real values.
# Next.js apps also read these via NEXT_PUBLIC_* variables at build time.

# -----------------------------------------------------------------------------
# Supabase (required by all apps for auth + DB)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Prisma / Database (required by @ictirc/database)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# App / Site URLs (used for redirects, metadata, sitemaps)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase Storage buckets
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_BUCKET_HOT=public-assets
NEXT_PUBLIC_SUPABASE_BUCKET_GUIDES=guides
NEXT_PUBLIC_SUPABASE_BUCKET_EVENTS=events

# -----------------------------------------------------------------------------
# Cloudflare R2 (used by @ictirc/storage for cold storage / videos)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME_COLD=cold-assets

# -----------------------------------------------------------------------------
# Algolia (used by @ictirc/search)
# -----------------------------------------------------------------------------
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_ADMIN_API_KEY=your-algolia-admin-key
NEXT_PUBLIC_ALGOLIA_APP_ID=your-algolia-app-id
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=your-algolia-search-key
ALGOLIA_INDEX_PREFIX=ictirc
NEXT_PUBLIC_ALGOLIA_INDEX_PREFIX=ictirc

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
CLOUDCONVERT_API_KEY=your-cloudconvert-api-key

# -----------------------------------------------------------------------------
# Google Drive / Service account (used by backup/archive flows)
# Uncomment and fill these in when you set up Google Drive integration.
# -----------------------------------------------------------------------------
# GDRIVE_SERVICE_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GDRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GDRIVE_BACKUP_FOLDER_ID=your-folder-id
