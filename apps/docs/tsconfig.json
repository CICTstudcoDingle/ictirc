{
  "extends": "@ictirc/config/typescript.json",
  "compilerOptions": {
    "target": "ES2017",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "lib": ["dom", "dom.iterable", "esnext"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true,
    "noEmit": true,
    "jsx": "preserve"
  },
  "exclude": ["node_modules"],
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ]
}
